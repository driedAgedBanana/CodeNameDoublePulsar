      m_Calls: []
  m_text: 'Both jumping and dashing use stamina.

    Watch the <color=#4CAF50>green
    bar</color> at the top of the screen.


    When the bar is low, the character
    will <b>sweat</b>.

    This means there is no stamina left.


    Without stamina,
    the character can only do <b>small jumps</b> and <b>cannot dash</b>.


    Stamina
    recharges automatically, but only when the character is <b>on the ground</b>.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: dc36b3fdc14f47ebb36fd484a67e268a, type: 2}
